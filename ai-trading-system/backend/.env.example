# ============================================================================
# AI TRADING SYSTEM - PRODUCTION CONFIGURATION
# ============================================================================
# ⚠️  CRITICAL: This system trades with REAL MONEY
# ⚠️  Read PRODUCTION_SETUP.md before configuring
# ============================================================================

# -----------------------------------------------------------------------------
# API KEYS - NEVER COMMIT REAL KEYS TO GIT
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_key_here
EXCHANGE_API_KEY=your_binance_api_key_here
EXCHANGE_API_SECRET=your_binance_api_secret_here

# Optional: OpenAI for GPT models
# OPENAI_API_KEY=your_openai_key_here

# -----------------------------------------------------------------------------
# EXCHANGE SETTINGS
# -----------------------------------------------------------------------------
EXCHANGE_TYPE=binance  # binance, hyperliquid (coming soon)
EXCHANGE_TESTNET=true  # ⚠️ SET TO TRUE FOR TESTING! false = real money

# -----------------------------------------------------------------------------
# TRADING PARAMETERS
# -----------------------------------------------------------------------------
INITIAL_CAPITAL=10000.0  # Starting capital in USD

# Position Sizing
MAX_POSITION_SIZE_PCT=10.0  # Max % of capital per position (conservative: 5-10%)
MAX_TOTAL_RISK_PCT=30.0  # Max % of total capital at risk (conservative: 20-30%)
MAX_LEVERAGE=5  # Max leverage multiplier (conservative: 1-5x)

# -----------------------------------------------------------------------------
# SAFETY MECHANISMS (CIRCUIT BREAKERS)
# -----------------------------------------------------------------------------
# ⚠️ These protect you from large losses - configure carefully!

ENABLE_TRADING=false  # Kill switch - must be explicitly enabled to trade
MAX_DRAWDOWN_PCT=10.0  # Pause trading if drawdown exceeds this (e.g., 10% = $1000 loss on $10k)
MAX_TRADES_PER_DAY=20  # Daily trade limit to prevent overtrading
MAX_CONSECUTIVE_LOSSES=3  # Pause after this many losses in a row
REQUIRE_MANUAL_APPROVAL=true  # Require approval for each trade (recommended for production)

# -----------------------------------------------------------------------------
# LLM SETTINGS
# -----------------------------------------------------------------------------
LLM_MODEL=claude-3-opus-20240229  # Model to use for trading decisions
LLM_TEMPERATURE=0.7  # Creativity (0.0-1.0, lower = more conservative)
LLM_MAX_TOKENS=2000  # Max response length

# -----------------------------------------------------------------------------
# DECISION PARAMETERS
# -----------------------------------------------------------------------------
DECISION_INTERVAL_SECONDS=180  # How often to make decisions (180 = 3 minutes)
MIN_CONFIDENCE_THRESHOLD=0.6  # Don't trade if LLM confidence below this (0.0-1.0)

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# SQLite for testing:
DATABASE_URL=sqlite:///./trading.db

# PostgreSQL for production (recommended):
# DATABASE_URL=postgresql://username:password@localhost:5432/trading_prod

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=trading.log  # Log file path

# -----------------------------------------------------------------------------
# MONITORING & ALERTS (Optional)
# -----------------------------------------------------------------------------
# Telegram Bot for alerts
ENABLE_TELEGRAM_ALERTS=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Sentry for error tracking (optional)
# SENTRY_DSN=your_sentry_dsn_here

# -----------------------------------------------------------------------------
# RECOMMENDED PRODUCTION SETTINGS
# -----------------------------------------------------------------------------
# Conservative (Low Risk):
# MAX_POSITION_SIZE_PCT=5.0
# MAX_TOTAL_RISK_PCT=20.0
# MAX_LEVERAGE=3
# MAX_DRAWDOWN_PCT=5.0
# MIN_CONFIDENCE_THRESHOLD=0.75
# REQUIRE_MANUAL_APPROVAL=true

# Moderate (Medium Risk):
# MAX_POSITION_SIZE_PCT=10.0
# MAX_TOTAL_RISK_PCT=30.0
# MAX_LEVERAGE=5
# MAX_DRAWDOWN_PCT=10.0
# MIN_CONFIDENCE_THRESHOLD=0.65
# REQUIRE_MANUAL_APPROVAL=true

# Aggressive (High Risk - NOT RECOMMENDED):
# MAX_POSITION_SIZE_PCT=20.0
# MAX_TOTAL_RISK_PCT=50.0
# MAX_LEVERAGE=10
# MAX_DRAWDOWN_PCT=15.0
# MIN_CONFIDENCE_THRESHOLD=0.55
# REQUIRE_MANUAL_APPROVAL=false

# -----------------------------------------------------------------------------
# DEPLOYMENT CHECKLIST
# -----------------------------------------------------------------------------
# Before going live with real money:
# [ ] Tested on testnet for 2+ weeks
# [ ] All safety parameters configured
# [ ] ENABLE_TRADING set to false initially
# [ ] REQUIRE_MANUAL_APPROVAL set to true
# [ ] Exchange API keys have correct permissions (NO WITHDRAW)
# [ ] Database backups configured
# [ ] Monitoring/alerts setup
# [ ] Emergency procedures documented
# [ ] Using risk capital only (can afford to lose)

# ============================================================================
# ⚠️  WARNING: NEVER SHARE THIS FILE PUBLICLY
# ⚠️  Add .env to .gitignore to prevent accidental commits
# ============================================================================
